<UserControl x:Class="ShortcutWindow.ShortcutToolWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:util="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
             xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             toolkit:Themes.UseVsTheme="True"
             Background="{DynamicResource {x:Static shell:VsBrushes.WindowKey}}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Fade in animation for shortcut display -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Fade out animation for shortcut display -->
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.3" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="pnlShortcut" Orientation="Vertical" Width="auto" Grid.Row="0">
            <!-- Container for shortcut parts (supports chord shortcuts like Ctrl+K, Ctrl+C) -->
            <StackPanel x:Name="pnlShortcutParts" Orientation="Horizontal" HorizontalAlignment="Center">
                <Label x:Name="lblShortcut"
                       FontSize="30"
                       HorizontalAlignment="Center"></Label>
                <!-- Separator and second part for chord shortcuts -->
                <Label x:Name="lblChordSeparator"
                       FontSize="30"
                       Content=","
                       Visibility="Collapsed"
                       Margin="0,0,5,0"
                       HorizontalAlignment="Center"></Label>
                <Label x:Name="lblShortcutChord"
                       FontSize="30"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"></Label>
                <!-- Repeat counter for when the same shortcut is pressed multiple times -->
                <Label x:Name="lblRepeatCount"
                       FontSize="20"
                       Visibility="Collapsed"
                       VerticalAlignment="Center"
                       Margin="5,0,0,0"
                       HorizontalAlignment="Center"></Label>
            </StackPanel>
            <Label x:Name="lblCommand"
                   FontSize="20"
                   Padding="0"
                   HorizontalAlignment="Center">Ready</Label>
        </StackPanel>

        <StackPanel Name="pnlControls" Grid.Row="1" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Left">
            <Button x:Name="btnPlayPause" Click="btnPlayPause_Click"
                    BorderThickness="0"
                    Width="40"
                    MinWidth="40"
                    Height="40"
                    FontSize="15"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    ToolTip="Toggle the play state of the Shortcut Presenter">
                ⏸️
            </Button>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center">
                <Hyperlink Click="Hyperlink_Click">Settings</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
